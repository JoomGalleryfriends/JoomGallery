<?xml version="1.0" encoding="utf-8"?>
<form>
  <fields name="filter">
    <field name="search" type="text" label="JSEARCH_FILTER" hint="JSEARCH_FILTER" class="js-stools-search-string" />
  </fields>
  <fields name="list">
    <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" onchange="this.form.submit();" default="u.name ASC" validate="options">
      <option value="">JGLOBAL_SORT_BY</option>
      <option value="u.name ASC">JGLOBAL_TITLE_ASC</option>
      <option value="u.name DESC">JGLOBAL_TITLE_DESC</option>
      <option value="u.username ASC">COM_JOOMGALLERY_USERNAME_ASC</option>
      <option value="u.username DESC">COM_JOOMGALLERY_USERNAME_DESC</option>
      <option value="a.created_time ASC">JDATE_ASC</option>
      <option value="a.created_time DESC">JDATE_DESC</option>
      <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
      <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
    </field>
    <field name="limit" type="limitbox" label="JSEARCH_FILTER_LIMIT" default="20" onchange="this.form.submit();" />
  </fields>
</form>
